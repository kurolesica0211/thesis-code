@prefix : <http://example.com/family_TBOX.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://example.com/family_TBOX.ttl#> .

<http://example.com/family_TBOX.ttl#> rdf:type owl:Ontology ;
                                       dcterms:source <http://www.co-ode.org/roberts/family-tree.owl> .

#################################################################
#    Annotation properties
#################################################################

###  http://example.com/family_TBOX.ttl#alsoKnownAs
:alsoKnownAs rdf:type owl:AnnotationProperty .


###  http://example.com/family_TBOX.ttl#formerlyKnownAs
:formerlyKnownAs rdf:type owl:AnnotationProperty .


###  http://example.com/family_TBOX.ttl#hasBirthYear
:hasBirthYear rdf:type owl:AnnotationProperty .


###  http://example.com/family_TBOX.ttl#hasDeathYear
:hasDeathYear rdf:type owl:AnnotationProperty .


###  http://example.com/family_TBOX.ttl#hasMarriageYear
:hasMarriageYear rdf:type owl:AnnotationProperty .


###  http://example.com/family_TBOX.ttl#knownAs
:knownAs rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://example.com/family_TBOX.ttl#hasBirthYear
:hasBirthYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.com/family_TBOX.ttl#hasAncestor
:hasAncestor rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasRelation ,
                                owl:topObjectProperty ;
             owl:inverseOf :isAncestorOf ;
             rdf:type owl:TransitiveProperty ;
             rdfs:domain :Person ;
             rdfs:range :Ancestor .


###  http://example.com/family_TBOX.ttl#hasBrother
:hasBrother rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isSiblingOf ;
            owl:inverseOf :isBrotherOf ;
            rdfs:domain :Person ;
            rdfs:range :Man ;
            owl:propertyDisjointWith :isChildOf ,
                                     :isParentOf .


###  http://example.com/family_TBOX.ttl#hasChild
:hasChild rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isAncestorOf ;
          owl:inverseOf :isChildOf ;
          rdfs:domain :Ancestor ;
          rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#hasDaughter
:hasDaughter rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasChild ,
                                :isParentOf ;
             owl:inverseOf :isDaughterOf ;
             rdfs:domain :Ancestor ;
             rdfs:range :Woman .


###  http://example.com/family_TBOX.ttl#hasFather
:hasFather rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasParent ;
           owl:inverseOf :isFatherOf ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Person ;
           rdfs:range :Ancestor ,
                      :Man .


###  http://example.com/family_TBOX.ttl#hasMother
:hasMother rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasParent ,
                              :isChildOf ;
           owl:inverseOf :isMotherOf ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Person ;
           rdfs:range :Ancestor ,
                      :Woman .


###  http://example.com/family_TBOX.ttl#hasParent
:hasParent rdf:type owl:ObjectProperty ;
           owl:equivalentProperty :isChildOf ;
           rdfs:subPropertyOf :hasAncestor ;
           owl:inverseOf :isParentOf ;
           rdfs:domain :Person ;
           rdfs:range :Ancestor ,
                      :Person .


###  http://example.com/family_TBOX.ttl#hasRelation
:hasRelation rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :Person ;
             rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#hasSex
:hasSex rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Person ;
        rdfs:range :Sex .


###  http://example.com/family_TBOX.ttl#hasSister
:hasSister rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :isSiblingOf ;
           owl:inverseOf :isSisterOf ;
           rdfs:domain :Person ;
           rdfs:range :Woman ;
           owl:propertyDisjointWith :isChildOf ,
                                    :isParentOf .


###  http://example.com/family_TBOX.ttl#hasSon
:hasSon rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasChild ,
                           :isParentOf ;
        owl:inverseOf :isSonOf ;
        rdfs:domain :Ancestor ;
        rdfs:range :Man .


###  http://example.com/family_TBOX.ttl#isAncestorOf
:isAncestorOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasRelation ;
              rdfs:domain :Ancestor ;
              rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#isAuntOf
:isAuntOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Woman ;
          rdfs:range :Person ;
          owl:propertyChainAxiom ( :isSisterOf
                                   :isParentOf
                                 ) .


###  http://example.com/family_TBOX.ttl#isBloodrelationOf
:isBloodrelationOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasRelation ,
                                      owl:topObjectProperty ;
                   rdfs:domain :Person ;
                   rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#isBrotherOf
:isBrotherOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isSiblingOf ;
             rdfs:domain :Man ;
             rdfs:range :Person ;
             owl:propertyDisjointWith :isChildOf ,
                                      :isParentOf .


###  http://example.com/family_TBOX.ttl#isChildOf
:isChildOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasAncestor ;
           rdfs:domain :Person ;
           rdfs:range :Ancestor ;
           owl:propertyDisjointWith :isSisterOf .


###  http://example.com/family_TBOX.ttl#isDaughterOf
:isDaughterOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasParent ,
                                 :isChildOf ;
              rdfs:domain :Woman ;
              rdfs:range :Ancestor .


###  http://example.com/family_TBOX.ttl#isFatherOf
:isFatherOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasChild ,
                               :isParentOf ;
            rdfs:domain :Ancestor ,
                        :Man ;
            rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#isMotherOf
:isMotherOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasChild ,
                               :isParentOf ;
            rdfs:domain :Ancestor ,
                        :Woman ;
            rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#isParentOf
:isParentOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isAncestorOf ;
            rdfs:domain :Ancestor ;
            rdfs:range :Person ;
            owl:propertyDisjointWith :isSisterOf .


###  http://example.com/family_TBOX.ttl#isSiblingOf
:isSiblingOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isBloodrelationOf ;
             rdf:type owl:SymmetricProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :Person ;
             rdfs:range :Person ;
             owl:propertyChainAxiom ( :hasParent
                                      :isParentOf
                                    ) .


###  http://example.com/family_TBOX.ttl#isSisterOf
:isSisterOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isSiblingOf ;
            rdfs:domain :Woman ;
            rdfs:range :Person .


###  http://example.com/family_TBOX.ttl#isSonOf
:isSonOf rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasParent ,
                            :isChildOf ;
         rdfs:domain :Man ;
         rdfs:range :Ancestor .


###  http://example.com/family_TBOX.ttl#isUncleOf
:isUncleOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Man ;
           rdfs:range :Person ;
           owl:propertyChainAxiom ( :isBrotherOf
                                    :isParentOf
                                  ) .


#################################################################
#    Classes
#################################################################

###  http://example.com/family_TBOX.ttl#Ancestor
:Ancestor rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Person
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :isAncestorOf ;
                                                       owl:someValuesFrom :Person
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          owl:disjointWith :Sex .


###  http://example.com/family_TBOX.ttl#DomainEntity
:DomainEntity rdf:type owl:Class .


###  http://example.com/family_TBOX.ttl#Female
:Female rdf:type owl:Class ;
        rdfs:subClassOf :Sex ;
        owl:disjointWith :Male .


###  http://example.com/family_TBOX.ttl#Male
:Male rdf:type owl:Class ;
      rdfs:subClassOf :Sex .


###  http://example.com/family_TBOX.ttl#Man
:Man rdf:type owl:Class ;
     owl:equivalentClass [ owl:intersectionOf ( :Person
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :hasSex ;
                                                  owl:someValuesFrom :Male
                                                ]
                                              ) ;
                           rdf:type owl:Class
                         ] ;
     owl:disjointWith :Sex ,
                      :Woman .


###  http://example.com/family_TBOX.ttl#Person
:Person rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Class ;
                              owl:unionOf ( :Man
                                            :Woman
                                          )
                            ] ;
        rdfs:subClassOf :DomainEntity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasFather ;
                          owl:someValuesFrom :Man
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasMother ;
                          owl:someValuesFrom :Woman
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasSex ;
                          owl:someValuesFrom :Sex
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasParent ;
                          owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                          owl:onClass :Person
                        ] ;
        owl:disjointWith :Sex .


###  http://example.com/family_TBOX.ttl#Sex
:Sex rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Class ;
                           owl:unionOf ( :Female
                                         :Male
                                       )
                         ] ;
     rdfs:subClassOf :DomainEntity .


###  http://example.com/family_TBOX.ttl#Woman
:Woman rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :Person
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :hasSex ;
                                                    owl:someValuesFrom :Female
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] .


