data:Prince_John_of_the_United_Kingdom a :Man,
        :Person ;
    :hasBirthYear 1905 ;
    :hasDeathYear 1919 ;
    :hasFather data:King_George_V ;
    :hasMother data:Queen_Mary ;
    :isSiblingOf data:Prince_Albert,
        data:Prince_Edward,
        data:Prince_George,
        data:Prince_Henry,
        data:Princess_Mary ;
    :knownAs "Johnnie"^^xsd:string .

data:Edward_VII a :Ancestor,
        :Man,
        :Person .

