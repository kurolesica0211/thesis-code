data:PrinceJohn a :Man,
        :Person ;
    :alsoKnownAs "Johnnie"^^xsd:string ;
    :hasBirthYear 1905 ;
    :hasDeathYear 1919 ;
    :hasFather data:KingGeorgeV ;
    :hasMother data:QueenMary ;
    :isSiblingOf data:PrinceAlbert,
        data:PrinceEdward,
        data:PrinceGeorge,
        data:PrinceHenry,
        data:PrincessMary ;
    :knownAs "John Charles Francis"^^xsd:string .

