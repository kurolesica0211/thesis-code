        :Person ;
    :alsoKnownAs "Sir Leopold Mountbatten"^^xsd:string ;
    :formerlyKnownAs "Prince Leopold of Battenberg"^^xsd:string ;
    :hasBirthYear 1889 ;
    :hasDeathYear 1922 ;
