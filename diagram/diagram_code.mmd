%%{init: {
  "themeVariables": {
    "fontSize": "28px",
    "fontFamily": "arial",
    "fontWeight": "bold",
    "nodeSpacing": 80,
    "rankSpacing": 180,
    "subgraphTitleColor": "#1A237E",
    "compositeTitleColor": "#1A237E"
  }
}}%%
flowchart LR
    %% Define Styles - High Contrast for Presentations
    classDef llm fill:#2B3A42,stroke:#FF9671,stroke-width:6px,color:#FFFFFF
    classDef tool fill:#E0F7FA,stroke:#00BCD4,stroke-width:3px,color:#000
    classDef logic fill:#FFF9C4,stroke:#FBC02D,stroke-width:3px,color:#000
    classDef mainLogic fill:#FFECB3,stroke:#FFC107,stroke-width:5px,color:#000
    classDef endGate fill:#C8E6C9,stroke:#2E7D32,stroke-width:5px,color:#000
    classDef inputDoc fill:#FFF3E0,stroke:#E65100,stroke-width:3px,color:#000
    classDef feedback fill:#FADBD8,stroke:#E74C3C,stroke-width:3px,color:#000
    classDef kg fill:#E8EAF6,stroke:#3F51B5,stroke-width:4px,color:#000

    %% Entry Point 
    Start[/fa:fa-copy <br/><b>INPUT DATA</b><br/>Text & Ontology/]:::inputDoc ----> MainLLM

    %% Main LLM Anchor
    MainLLM["fa:fa-robot <br><b>MAIN AGENT LLM</b><br>"]:::llm

    %% Tool Selection
    MainLLM ====> Tools{{fa:fa-toolbox <br/>SELECT TOOL}}:::mainLogic

    %% Validation Logic (Top branch)
    subgraph Validation [fa:fa-shield-halved SHACL VALIDATION LOOP]
        direction LR
        V_Tool([ValidateSHACL]):::tool ----> RunSHACL(Run Engine)
        RunSHACL ----> ViolationCheck{Any<br>Errors?}:::logic
        
        ViolationCheck -- "Yes" ----> ExplainerLLM["fa:fa-brain <br><b>EXPLAINER LLM</b><br>"]:::llm
        ExplainerLLM ----> Feedback[/Fix Instructions/]:::feedback
        
        ViolationCheck -- "No" ----> SuccessMsg[/Validation Success/]
    end

    %% Finish Gatekeeper (Middle branch)
    subgraph Finish_Gate [fa:fa-lock FINISH GATEKEEPER]
        direction LR
        Finish([Finish]):::tool ----> EnforcementCheck{SHACL<br>ON?}:::logic
        
        EnforcementCheck -- "Yes" ----> UsedSHACL{Used<br>Tool?}:::logic
        UsedSHACL -- "Yes" ----> LastValid{Last<br>Valid?}:::logic
        
        EnforcementCheck -- "No" ----> EndNode(((fa:fa-circle-check <br/>SUCCESS))):::endGate
        LastValid -- "Yes" ----> EndNode
        
        UsedSHACL -- "No" ----> Reject1[/Prompt: MUST VALIDATE/]:::feedback
        LastValid -- "No" ----> Reject2[/Prompt: FIX ERRORS/]:::feedback
    end

    %% KG Editing Tools (Bottom branch)
    subgraph KG_Edits [fa:fa-pen-to-square KG EDITING TOOLS]
        direction TB
        T1([AddTriple]):::tool
        T2([RemoveTriple]):::tool
        T3([AssignClass]):::tool
        T4([UnassignClass]):::tool
        T5([AddLiteral]):::tool
        T6([RemoveLiteral]):::tool
    end

    %% Connect Tools to their respective paths
    Tools ----> V_Tool
    Tools ----> Finish
    Tools ----> T1 & T2 & T3 & T4 & T5 & T6

    %% Knowledge Graph Connections
    T1 & T2 & T3 & T4 & T5 & T6 ----> KG[(fa:fa-database <br/>KNOWLEDGE GRAPH)]:::kg
    
    %% Return Loops back to Main LLM
    KG -.-> MainLLM
    Feedback -.-> MainLLM
    SuccessMsg -.-> MainLLM
    Reject1 -.-> MainLLM
    Reject2 -.-> MainLLM

    %% SUBGRAPH STYLING - High Visibility
    style Validation fill:none,stroke:#1A237E,stroke-dasharray: 10 5,stroke-width:3px
    style Finish_Gate fill:none,stroke:#1A237E,stroke-dasharray: 10 5,stroke-width:3px
    style KG_Edits fill:none,stroke:#1A237E,stroke-dasharray: 10 5,stroke-width:3px